{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aide",
  "version": "0.1.0",
  "identifier": "com.huangmin.aide",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "aide",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDNTkwNjlGQjlENzg4RDEKUldUUmlOZTVud1paN0twSm9iWHpTR0kvKzIxZ2VjOTZqQytUWGVlOTB5d3NjUTFpeVVPR1F5UzcK",
      "endpoints": [
        "https://github.com/lexmin0412/aide/releases/latest/download/latest.json"
      ]
    }
  }
}
